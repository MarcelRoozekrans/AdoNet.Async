<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- EPS06: ErrorProne.NET false positives with FluentAssertions .Should() and NSubstitute .Returns() on value types -->
    <NoWarn>$(NoWarn);EPS06</NoWarn>
  </PropertyGroup>
</Project>
