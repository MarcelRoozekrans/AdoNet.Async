<?xml version="1.0" standalone="yes"?>
<!--
  Schema where table elements reference top-level xs:complexType definitions
  via type="mstns:TypeName" — the pattern generated by the VS DataSet Designer.
  Regression coverage for issue #55.
-->
<xs:schema id="ExternalTypeRefDS"
           targetNamespace="http://tempuri.org/ExternalTypeRefDS.xsd"
           xmlns:mstns="http://tempuri.org/ExternalTypeRefDS.xsd"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:msdata="urn:schemas-microsoft-com:xml-msdata"
           xmlns:codegen="urn:schemas-microsoft-com:xml-msprop">

  <!-- Top-level complexType: columns defined outside the DataSet element -->
  <xs:complexType name="OrderType">
    <xs:sequence>
      <xs:element name="OrderId"   type="xs:int" />
      <xs:element name="CustomerId" type="xs:int" />
      <xs:element name="Amount"    type="xs:decimal" />
      <xs:element name="Note"      type="xs:string" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <!-- Second top-level type with xs:attribute columns -->
  <xs:complexType name="TagType">
    <xs:attribute name="TagId"  type="xs:int"    use="required" />
    <xs:attribute name="Label"  type="xs:string" use="required" />
    <xs:attribute name="Color"  type="xs:string" />
  </xs:complexType>

  <xs:element name="ExternalTypeRefDS" msdata:IsDataSet="true">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <!-- Both tables use external type references -->
        <xs:element name="Order" type="mstns:OrderType" />
        <xs:element name="Tag"   type="mstns:TagType" />
      </xs:choice>
    </xs:complexType>
    <xs:key name="PK_Order" msdata:PrimaryKey="true">
      <xs:selector xpath=".//mstns:Order" />
      <xs:field xpath="OrderId" />
    </xs:key>
    <xs:key name="PK_Tag" msdata:PrimaryKey="true">
      <xs:selector xpath=".//mstns:Tag" />
      <xs:field xpath="@TagId" />
    </xs:key>
  </xs:element>
</xs:schema>
