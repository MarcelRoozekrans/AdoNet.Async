<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>System.Data.Async.AotSmoke</RootNamespace>
    <AssemblyName>System.Data.Async.AotSmoke</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Drives the actual AOT publish. The CI job runs `dotnet publish -c Release` so
         these properties are honoured. Local `dotnet build` skips AOT compilation but
         still runs the trim/AOT analyzers because IsAotCompatible / IsTrimmable below. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Surface every individual warning rather than rolling them up to a single
         IL2104. The whole point of this smoke test is to catch newly introduced
         AOT/trim warnings on consumer-visible API surface. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both AOT-declared core packages are exercised from this consumer end-to-end. -->
    <ProjectReference Include="..\..\src\System.Data.Async\System.Data.Async.csproj" />
    <ProjectReference Include="..\..\src\System.Data.Async.Adapters\System.Data.Async.Adapters.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Data.Sqlite is itself AOT-compatible (Microsoft declares it). Using
         the in-memory connection string keeps the smoke test hermetic — no Docker, no
         disk I/O, no service container required from the CI runner. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
  </ItemGroup>
</Project>
