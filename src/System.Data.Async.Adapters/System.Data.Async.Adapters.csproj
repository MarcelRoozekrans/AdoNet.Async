<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>System.Data.Async.Adapters</RootNamespace>
    <PackageId>AdoNet.Async.Adapters</PackageId>
    <Title>AdoNet.Async.Adapters</Title>
    <Description>Adapters wrapping existing ADO.NET providers (DbConnection, DbCommand, DbDataReader) into async interfaces. Includes .AsAsync() extension and DI support.</Description>
    <PackageTags>system.data.async;async;ado.net;adapter;dbconnection;dbcommand;dependency-injection;valuetask;nativeaot;trimming</PackageTags>
    <!-- Adapter wraps user-supplied DbProviderFactory / DbConnection instances. The
         wrapper code is reflection-free (factory is passed as an instance, not
         registered via the reflective DbProviderFactories.GetFactory path). AOT-safe
         as long as consumers pass the factory instance directly via AddAsyncData(...). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\System.Data.Async\System.Data.Async.csproj" />
    <ProjectReference Include="..\System.Data.Async.DataSet\System.Data.Async.DataSet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>
</Project>
